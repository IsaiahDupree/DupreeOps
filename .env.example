# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Resend email — contact-form lead notifications (see lib/email.ts)
# RESEND_API_KEY: create at https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
# Sender must be on a Resend-verified domain. Interim: verified everreach.app sender
# with Reply-To dupreeops.com. To send FROM @dupreeops.com, add it in Resend (Pro) and
# change CONTACT_FROM_EMAIL — no code change needed.
CONTACT_FROM_EMAIL=DupreeOps <notifications@everreach.app>
# Where new-lead notifications are delivered (a real inbox you read):
CONTACT_NOTIFY_EMAIL=you@example.com
# (Reply-To is set automatically to the prospect's own email, so replying to a
#  notification answers the lead directly — no env var needed.)
