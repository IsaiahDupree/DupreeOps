{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014oTfDGFY36ZW3K5JC51nU2","type":"tool_result","content":"     1→import type { NextApiRequest, NextApiResponse } from 'next'\n     2→import { createServerClient } from '@/lib/supabase'\n     3→import { validateContactForm, type ContactFormData } from '@/lib/validation'\n     4→\n     5→interface SuccessResponse {\n     6→  success: true\n     7→  message: string\n     8→  id?: string\n     9→}\n    10→\n    11→interface ErrorResponse {\n    12→  success: false\n    13→  message: string\n    14→  errors?: Array<{ field: string; message: string }>\n    15→}\n    16→\n    17→type Response = SuccessResponse | ErrorResponse\n    18→\n    19→export default async function handler(\n    20→  req: NextApiRequest,\n    21→  res: NextApiResponse<Response>\n    22→) {\n    23→  // Only allow POST requests\n    24→  if (req.method !== 'POST') {\n    25→    return res.status(405).json({\n    26→      success: false,\n    27→      message: 'Method not allowed',\n    28→    })\n    29→  }\n    30→\n    31→  try {\n    32→    const { name, email, message } = req.body\n    33→\n    34→    // Validate input\n    35→    const formData: Partial<ContactFormData> = { name, email, message }\n    36→    const validationErrors = validateContactForm(formData)\n    37→\n    38→    if (validationErrors.length > 0) {\n    39→      return res.status(400).json({\n    40→        success: false,\n    41→        message: 'Validation failed',\n    42→        errors: validationErrors,\n    43→      })\n    44→    }\n    45→\n    46→    // Create server client and insert into database\n    47→    const supabase = createServerClient()\n    48→\n    49→    const { data, error } = await supabase\n    50→      .from('contact_submissions')\n    51→      .insert({\n    52→        name,\n    53→        email,\n    54→        message,\n    55→        created_at: new Date().toISOString(),\n    56→      })\n    57→      .select('id')\n    58→      .single()\n    59→\n    60→    if (error) {\n    61→      console.error('Supabase error:', error)\n    62→      return res.status(500).json({\n    63→        success: false,\n    64→        message: 'Failed to save submission. Please try again later.',\n    65→      })\n    66→    }\n    67→\n    68→    return res.status(200).json({\n    69→      success: true,\n    70→      message: 'Contact form submitted successfully',\n    71→      id: data?.id,\n    72→    })\n    73→  } catch (error) {\n    74→    console.error('Contact API error:', error)\n    75→    return res.status(500).json({\n    76→      success: false,\n    77→      message: 'An unexpected error occurred. Please try again later.',\n    78→    })\n    79→  }\n    80→}\n    81→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e0b6fff0-4192-4f9e-9ee3-3ef453685716","uuid":"5e90612e-8afe-4b64-96a9-9f1864ad51d5","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/DupreeOpsLLC/pages/api/contact.ts","content":"import type { NextApiRequest, NextApiResponse } from 'next'\nimport { createServerClient } from '@/lib/supabase'\nimport { validateContactForm, type ContactFormData } from '@/lib/validation'\n\ninterface SuccessResponse {\n  success: true\n  message: string\n  id?: string\n}\n\ninterface ErrorResponse {\n  success: false\n  message: string\n  errors?: Array<{ field: string; message: string }>\n}\n\ntype Response = SuccessResponse | ErrorResponse\n\nexport default async function handler(\n  req: NextApiRequest,\n  res: NextApiResponse<Response>\n) {\n  // Only allow POST requests\n  if (req.method !== 'POST') {\n    return res.status(405).json({\n      success: false,\n      message: 'Method not allowed',\n    })\n  }\n\n  try {\n    const { name, email, message } = req.body\n\n    // Validate input\n    const formData: Partial<ContactFormData> = { name, email, message }\n    const validationErrors = validateContactForm(formData)\n\n    if (validationErrors.length > 0) {\n      return res.status(400).json({\n        success: false,\n        message: 'Validation failed',\n        errors: validationErrors,\n      })\n    }\n\n    // Create server client and insert into database\n    const supabase = createServerClient()\n\n    const { data, error } = await supabase\n      .from('contact_submissions')\n      .insert({\n        name,\n        email,\n        message,\n        created_at: new Date().toISOString(),\n      })\n      .select('id')\n      .single()\n\n    if (error) {\n      console.error('Supabase error:', error)\n      return res.status(500).json({\n        success: false,\n        message: 'Failed to save submission. Please try again later.',\n      })\n    }\n\n    return res.status(200).json({\n      success: true,\n      message: 'Contact form submitted successfully',\n      id: data?.id,\n    })\n  } catch (error) {\n    console.error('Contact API error:', error)\n    return res.status(500).json({\n      success: false,\n      message: 'An unexpected error occurred. Please try again later.',\n    })\n  }\n}\n","numLines":81,"startLine":1,"totalLines":81}}}
