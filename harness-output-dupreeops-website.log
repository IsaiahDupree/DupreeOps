{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HYp9de3nxWdRkdygEeWqFK","type":"tool_result","content":"The file /Users/isaiahdupree/Documents/Software/DupreeOpsLLC/pages/contact.tsx has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"e0b6fff0-4192-4f9e-9ee3-3ef453685716","uuid":"43361ae4-76bd-4129-964b-502fcd1dad94","tool_use_result":{"filePath":"/Users/isaiahdupree/Documents/Software/DupreeOpsLLC/pages/contact.tsx","oldString":"      <Head>\n        <title>Contact • Dupree Ops, LLC</title>\n        <meta name=\"description\" content=\"Contact Dupree Ops, LLC for support, partnerships, or verification.\" />\n        <meta\n          name=\"viewport\"\n          content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes\"\n        />\n        <meta name=\"theme-color\" content=\"#0f172a\" media=\"(prefers-color-scheme: dark)\" />\n        <meta name=\"theme-color\" content=\"#f8fafc\" media=\"(prefers-color-scheme: light)\" />\n      </Head>","newString":"      <Head>\n        <title>Contact • Dupree Ops, LLC</title>\n        <meta name=\"description\" content=\"Contact Dupree Ops, LLC for support, partnerships, or verification.\" />\n        <meta\n          name=\"viewport\"\n          content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes\"\n        />\n\n        {/* SEO Tags */}\n        <meta name=\"keywords\" content=\"contact, support, partnership, business inquiry\" />\n        <meta name=\"robots\" content=\"index, follow\" />\n\n        {/* Open Graph */}\n        <meta property=\"og:type\" content=\"website\" />\n        <meta property=\"og:title\" content=\"Contact • Dupree Ops, LLC\" />\n        <meta property=\"og:description\" content=\"Contact Dupree Ops, LLC for support, partnerships, or verification.\" />\n        <meta property=\"og:url\" content=\"https://dupreeops.com/contact\" />\n        <meta property=\"og:image\" content=\"https://dupreeops.com/og-image.jpg\" />\n\n        {/* Twitter Card */}\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\n        <meta name=\"twitter:title\" content=\"Contact • Dupree Ops, LLC\" />\n        <meta name=\"twitter:description\" content=\"Contact Dupree Ops, LLC for support, partnerships, or verification.\" />\n\n        {/* Theme & Mobile */}\n        <meta name=\"theme-color\" content=\"#0f172a\" media=\"(prefers-color-scheme: dark)\" />\n        <meta name=\"theme-color\" content=\"#f8fafc\" media=\"(prefers-color-scheme: light)\" />\n\n        {/* Canonical */}\n        <link rel=\"canonical\" href=\"https://dupreeops.com/contact\" />\n      </Head>","originalFile":"import Head from 'next/head'\nimport Link from 'next/link'\nimport { useTheme } from '@/hooks/useTheme'\nimport { trackThemeToggle, trackLinkClick, trackEmailClick } from '@/lib/analytics'\nimport ContactForm from '@/components/ContactForm'\n\nexport default function Contact() {\n  const { theme, toggleTheme, mounted } = useTheme()\n\n  const handleThemeToggle = () => {\n    const newTheme = theme === 'dark' ? 'light' : 'dark'\n    toggleTheme()\n    trackThemeToggle(newTheme)\n  }\n\n  if (!mounted) {\n    return null\n  }\n\n  return (\n    <>\n      <Head>\n        <title>Contact • Dupree Ops, LLC</title>\n        <meta name=\"description\" content=\"Contact Dupree Ops, LLC for support, partnerships, or verification.\" />\n        <meta\n          name=\"viewport\"\n          content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes\"\n        />\n        <meta name=\"theme-color\" content=\"#0f172a\" media=\"(prefers-color-scheme: dark)\" />\n        <meta name=\"theme-color\" content=\"#f8fafc\" media=\"(prefers-color-scheme: light)\" />\n      </Head>\n\n      <main className=\"min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors\">\n        <div className=\"max-w-4xl mx-auto px-4 sm:px-6 py-4 sm:py-6 md:py-10 space-y-4 sm:space-y-6\">\n          {/* Header with theme toggle */}\n          <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4\">\n            <Link\n              href=\"/\"\n              onClick={() => trackLinkClick('/', 'Back to home')}\n              className=\"text-sm sm:text-base text-emerald-700 active:text-emerald-600 hover:text-emerald-500 dark:text-emerald-400 dark:active:text-emerald-300 dark:hover:text-emerald-300 transition-colors touch-manipulation\"\n            >\n              [ ← Back to home ]\n            </Link>\n            <button\n              type=\"button\"\n              onClick={handleThemeToggle}\n              className=\"inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 shadow-sm active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[44px]\"\n            >\n              <span className=\"text-xs\">{theme === 'dark' ? '🌙' : '☀️'}</span>\n              <span>{theme === 'dark' ? 'Dark mode' : 'Light mode'}</span>\n            </button>\n          </div>\n\n          {/* Contact form section */}\n          <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 sm:p-5 md:p-6 dark:border-slate-800 dark:bg-slate-900/70\">\n            <AsciiHeading label=\"GET IN TOUCH\" />\n            <p className=\"mt-4 text-sm sm:text-base text-slate-700 dark:text-slate-200 mb-4 sm:mb-6\">\n              Have a project in mind or want to learn more about our services? Fill out the form below and\n              we'll get back to you within 1-2 business days.\n            </p>\n            <ContactForm />\n          </div>\n\n          {/* Additional contact methods */}\n          <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 sm:p-5 md:p-6 dark:border-slate-800 dark:bg-slate-900/70\">\n            <AsciiHeading label=\"OTHER WAYS TO REACH US\" />\n\n            <div className=\"mt-4 sm:mt-6 space-y-4 sm:space-y-5 text-sm sm:text-base text-slate-700 dark:text-slate-200\">\n              <div>\n                <p className=\"text-emerald-700 dark:text-emerald-400 mb-2 font-semibold\">\n                  &gt;&gt; General & Business Inquiries\n                </p>\n                <p>\n                  <a\n                    href=\"mailto:hello@dupreeops.com\"\n                    onClick={() => trackEmailClick('hello@dupreeops.com')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    hello@dupreeops.com\n                  </a>\n                </p>\n                <p className=\"mt-1 text-slate-600 dark:text-slate-300\">\n                  For partnerships, new projects, and general business questions.\n                </p>\n              </div>\n\n              <div>\n                <p className=\"text-emerald-700 dark:text-emerald-400 mb-2 font-semibold\">\n                  &gt;&gt; Customer Support\n                </p>\n                <p>\n                  <a\n                    href=\"mailto:support@dupreeops.com\"\n                    onClick={() => trackEmailClick('support@dupreeops.com')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    support@dupreeops.com\n                  </a>\n                </p>\n                <p className=\"mt-1 text-slate-600 dark:text-slate-300\">\n                  For product support, billing questions, refund requests, and SMS opt-out\n                  assistance. Typical response time: 1–2 business days.\n                </p>\n              </div>\n\n              <div>\n                <p className=\"text-emerald-700 dark:text-emerald-400 mb-2 font-semibold\">\n                  &gt;&gt; Business Information\n                </p>\n                <p>Dupree Ops, LLC</p>\n                <p>3425 Delaney Drive, Melbourne, FL 32934</p>\n                <p className=\"mt-1 text-slate-600 dark:text-slate-300\">\n                  For written correspondence or provider verification, contact us via email with\n                  your reference ID and we will provide documentation confirming ownership of\n                  domains, products, and messaging programs.\n                </p>\n              </div>\n\n              <div>\n                <p className=\"text-emerald-700 dark:text-emerald-400 mb-2 font-semibold\">\n                  &gt;&gt; Social Profiles\n                </p>\n                <div className=\"flex flex-wrap gap-3 mt-1\">\n                  <a\n                    href=\"https://x.com/isaiahdupree33\"\n                    target=\"_blank\"\n                    rel=\"noreferrer\"\n                    onClick={() => trackLinkClick('https://x.com/isaiahdupree33', 'Twitter / X')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    Twitter / X →\n                  </a>\n                  <a\n                    href=\"https://www.linkedin.com/in/isaiah-dupree33/\"\n                    target=\"_blank\"\n                    rel=\"noreferrer\"\n                    onClick={() => trackLinkClick('https://www.linkedin.com/in/isaiah-dupree33/', 'LinkedIn')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    LinkedIn →\n                  </a>\n                  <a\n                    href=\"https://github.com/IsaiahDupree\"\n                    target=\"_blank\"\n                    rel=\"noreferrer\"\n                    onClick={() => trackLinkClick('https://github.com/IsaiahDupree', 'GitHub')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    GitHub →\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n    </>\n  )\n}\n\nfunction AsciiHeading({ label }: { label: string }) {\n  const line = '═'.repeat(Math.max(label.length + 4, 28))\n  return (\n    <pre className=\"text-xs md:text-sm leading-snug text-emerald-700 dark:text-emerald-400 whitespace-pre font-mono\">\n{`╔${line}╗\n║ ${label.padEnd(line.length - 2, ' ')}║\n╚${line}╝`}\n    </pre>\n  )\n}\n","structuredPatch":[{"oldStart":26,"oldLines":8,"newStart":26,"newLines":29,"lines":["           name=\"viewport\"","           content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes\"","         />","+","+        {/* SEO Tags */}","+        <meta name=\"keywords\" content=\"contact, support, partnership, business inquiry\" />","+        <meta name=\"robots\" content=\"index, follow\" />","+","+        {/* Open Graph */}","+        <meta property=\"og:type\" content=\"website\" />","+        <meta property=\"og:title\" content=\"Contact • Dupree Ops, LLC\" />","+        <meta property=\"og:description\" content=\"Contact Dupree Ops, LLC for support, partnerships, or verification.\" />","+        <meta property=\"og:url\" content=\"https://dupreeops.com/contact\" />","+        <meta property=\"og:image\" content=\"https://dupreeops.com/og-image.jpg\" />","+","+        {/* Twitter Card */}","+        <meta name=\"twitter:card\" content=\"summary_large_image\" />","+        <meta name=\"twitter:title\" content=\"Contact • Dupree Ops, LLC\" />","+        <meta name=\"twitter:description\" content=\"Contact Dupree Ops, LLC for support, partnerships, or verification.\" />","+","+        {/* Theme & Mobile */}","         <meta name=\"theme-color\" content=\"#0f172a\" media=\"(prefers-color-scheme: dark)\" />","         <meta name=\"theme-color\" content=\"#f8fafc\" media=\"(prefers-color-scheme: light)\" />","+","+        {/* Canonical */}","+        <link rel=\"canonical\" href=\"https://dupreeops.com/contact\" />","       </Head>"," ","       <main className=\"min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors\">"]}],"userModified":false,"replaceAll":false}}
