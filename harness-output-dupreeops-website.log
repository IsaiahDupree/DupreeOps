{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01ReCeaVafWemjunza3qv1EZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01F6ZedLmyNALDogW1DYnmnc","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/DupreeOpsLLC/lib/validation.ts","content":"export interface ContactFormData {\n  name: string\n  email: string\n  message: string\n}\n\nexport interface ValidationError {\n  field: string\n  message: string\n}\n\nexport function validateContactForm(data: Partial<ContactFormData>): ValidationError[] {\n  const errors: ValidationError[] = []\n\n  if (!data.name || data.name.trim() === '') {\n    errors.push({ field: 'name', message: 'Name is required' })\n  } else if (data.name.length < 2) {\n    errors.push({ field: 'name', message: 'Name must be at least 2 characters' })\n  } else if (data.name.length > 100) {\n    errors.push({ field: 'name', message: 'Name must be less than 100 characters' })\n  }\n\n  if (!data.email || data.email.trim() === '') {\n    errors.push({ field: 'email', message: 'Email is required' })\n  } else if (!isValidEmail(data.email)) {\n    errors.push({ field: 'email', message: 'Invalid email format' })\n  }\n\n  if (!data.message || data.message.trim() === '') {\n    errors.push({ field: 'message', message: 'Message is required' })\n  } else if (data.message.length < 10) {\n    errors.push({ field: 'message', message: 'Message must be at least 10 characters' })\n  } else if (data.message.length > 5000) {\n    errors.push({ field: 'message', message: 'Message must be less than 5000 characters' })\n  }\n\n  return errors\n}\n\nexport function isValidEmail(email: string): boolean {\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/\n  return emailRegex.test(email)\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":1087,"cache_read_input_tokens":112294,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1087},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"bec0f40b-0ded-4745-babc-d02bc5d84c78","uuid":"e06f09ac-6957-4c07-95a5-f79174982dbb"}
