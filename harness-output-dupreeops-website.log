{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01BVKmtPeUvSAVpHmpBRrfXc","type":"message","role":"assistant","content":[{"type":"text","text":"**Step 5: Add form rate limiting (FORM-007)**"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":1146,"cache_read_input_tokens":117391,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1146},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e0b6fff0-4192-4f9e-9ee3-3ef453685716","uuid":"35d10d98-9a6d-4ec2-93ba-c1b21668b102"}
{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_01BVKmtPeUvSAVpHmpBRrfXc","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018QL9XcwmuZr53ShDBta9Xw","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/DupreeOpsLLC/lib/rate-limit.ts","content":"/**\n * Simple in-memory rate limiting for API endpoints\n * Store: { ip: string, endpoint: string, timestamps: number[] }\n */\n\ninterface RateLimitEntry {\n  timestamps: number[]\n}\n\ntype RateLimitStore = Map<string, RateLimitEntry>\n\nconst store: RateLimitStore = new Map()\n\n// Configuration\nconst CONFIG = {\n  // Contact form: max 5 submissions per hour per IP\n  contact: { maxRequests: 5, windowMs: 60 * 60 * 1000 }, // 1 hour\n  // General API: max 100 requests per minute per IP\n  api: { maxRequests: 100, windowMs: 60 * 1000 }, // 1 minute\n}\n\n/**\n * Get client IP from request\n */\nexport function getClientIp(\n  headers: Record<string, string | string[] | undefined>\n): string {\n  const forwarded = headers['x-forwarded-for']\n  if (typeof forwarded === 'string') {\n    return forwarded.split(',')[0].trim()\n  }\n  return headers['x-real-ip'] as string || 'unknown'\n}\n\n/**\n * Check if request exceeds rate limit\n */\nexport function checkRateLimit(\n  key: string,\n  type: 'contact' | 'api' = 'api'\n): { allowed: boolean; remaining: number; resetAt: number } {\n  const now = Date.now()\n  const config = CONFIG[type]\n\n  // Get or create entry\n  let entry = store.get(key)\n  if (!entry) {\n    entry = { timestamps: [] }\n    store.set(key, entry)\n  }\n\n  // Remove old timestamps outside window\n  entry.timestamps = entry.timestamps.filter((ts) => now - ts < config.windowMs)\n\n  // Check if limit exceeded\n  const remaining = Math.max(0, config.maxRequests - entry.timestamps.length)\n  const allowed = entry.timestamps.length < config.maxRequests\n\n  // Add current timestamp if allowed\n  if (allowed) {\n    entry.timestamps.push(now)\n  }\n\n  // Calculate reset time\n  const oldestTimestamp = entry.timestamps[0]\n  const resetAt = oldestTimestamp\n    ? oldestTimestamp + config.windowMs\n    : now + config.windowMs\n\n  return { allowed, remaining, resetAt }\n}\n\n/**\n * Cleanup old entries (call periodically)\n */\nexport function cleanupRateLimitStore() {\n  const now = Date.now()\n  const maxWindow = Math.max(CONFIG.contact.windowMs, CONFIG.api.windowMs)\n\n  for (const [key, entry] of store.entries()) {\n    entry.timestamps = entry.timestamps.filter((ts) => now - ts < maxWindow)\n\n    if (entry.timestamps.length === 0) {\n      store.delete(key)\n    }\n  }\n}\n\n// Cleanup every 5 minutes\nif (typeof global !== 'undefined' && !global._rateLimitCleanupInterval) {\n  global._rateLimitCleanupInterval = setInterval(() => {\n    cleanupRateLimitStore()\n  }, 5 * 60 * 1000)\n}\n\ndeclare global {\n  var _rateLimitCleanupInterval: NodeJS.Timer | undefined\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":1146,"cache_read_input_tokens":117391,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1146},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e0b6fff0-4192-4f9e-9ee3-3ef453685716","uuid":"10c78c6e-c640-414c-8be7-9a7ed492ce9d"}
