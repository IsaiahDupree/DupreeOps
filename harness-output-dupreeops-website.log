ice with description and CTA\",\n      \"priority\": \"P0\",\n      \"phase\": 2,\n      \"effort\": \"3h\",\n      \"passes\": true,\n      \"category\": \"services\",\n      \"files\": [\n        \"components/ServiceCard.tsx\",\n        \"data/services.ts\"\n      ],\n      \"acceptance\": [\n        \"service name visible\",\n        \"price $1,500 displayed\",\n        \"description shown\",\n        \"CTA button present\"\n      ],\n      \"dependencies\": [\n        \"SVC-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"SVC-005\",\n      \"name\": \"Add service pricing display\",\n      \"description\": \"Create consistent pricing display across all service cards\",\n      \"priority\": \"P0\",\n      \"phase\": 2,\n      \"effort\": \"2h\",\n      \"passes\": true,\n      \"category\": \"services\",\n      \"files\": [\n        \"components/PricingBadge.tsx\"\n      ],\n      \"acceptance\": [\n        \"prices formatted consistently\",\n        \"currency symbols correct\",\n        \"billing period shown for monthly\"\n      ],\n      \"dependencies\": [\n        \"SVC-002\",\n        \"SVC-003\",\n        \"SVC-004\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"SVC-006\",\n      \"name\": \"Add service benefits/features\",\n      \"description\": \"Display key benefits and features for each service\",\n      \"priority\": \"P1\",\n      \"phase\": 2,\n      \"effort\": \"4h\",\n      \"passes\": true,\n      \"category\": \"services\",\n      \"files\": [\n        \"components/ServiceCard.tsx\",\n        \"data/services.ts\"\n      ],\n      \"acceptance\": [\n        \"benefits listed for each service\",\n        \"icons or bullets visible\",\n        \"content matches marketing copy\"\n      ],\n      \"dependencies\": [\n        \"SVC-002\",\n        \"SVC-003\",\n        \"SVC-004\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"SVC-007\",\n      \"name\": \"Create service comparison table\",\n      \"description\": \"Add optional comparison table showing all services side-by-side\",\n      \"priority\": \"P2\",\n      \"phase\": 2,\n      \"effort\": \"4h\",\n      \"passes\": true,\n      \"category\": \"services\",\n      \"files\": [\n        \"components/ServiceComparison.tsx\"\n      ],\n      \"acceptance\": [\n        \"table renders correctly\",\n        \"all services included\",\n        \"key differences highlighted\"\n      ],\n      \"dependencies\": [\n        \"SVC-002\",\n        \"SVC-003\",\n        \"SVC-004\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"SVC-008\",\n      \"name\": \"Add testimonials section\",\n      \"description\": \"Include customer testimonials for services\",\n      \"priority\": \"P2\",\n      \"phase\": 2,\n      \"effort\": \"3h\",\n      \"passes\": true,\n      \"category\": \"services\",\n      \"files\": [\n        \"components/Testimonials.tsx\",\n        \"data/testimonials.ts\"\n      ],\n      \"acceptance\": [\n        \"testimonials section visible\",\n        \"at least 3 testimonials shown\",\n        \"author/company names included\"\n      ],\n      \"dependencies\": [\n        \"SVC-001\"\n      ],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"FORM-001\",\n      \"name\": \"Create contact form UI\",\n      \"description\": \"Build contact form component with name, email, and message fields\",\n      \"priority\": \"P0\",\n      \"phase\": 3,\n      \"effort\": \"3h\",\n      \"passes\": true,\n      \"category\": \"forms\",\n      \"files\": [\n        \"components/ContactForm.tsx\",\n        \"pages/contact.tsx\"\n      ],\n      \"acceptance\": [\n        \"form renders\",\n        \"all three fields present\",\n        \"submit button visible\",\n        \"accessible form labels\"\n      ],\n      \"dependencies\": [],\n      \"status\": \"completed\"\n    },\n    {\n      \"id\": \"FORM-002\",\n      \"name\": \"