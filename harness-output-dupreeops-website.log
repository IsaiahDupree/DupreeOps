{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FwMVJzrr9bAtP2LdbQ1YLL","type":"tool_result","content":"     1→import '@/styles/globals.css'\n     2→import type { AppProps } from 'next/app'\n     3→import { useEffect } from 'react'\n     4→import { useRouter } from 'next/router'\n     5→import { trackPageView } from '@/lib/analytics'\n     6→import { Space_Grotesk } from 'next/font/google'\n     7→\n     8→const spaceGrotesk = Space_Grotesk({\n     9→  subsets: ['latin'],\n    10→  variable: '--font-space-grotesk',\n    11→  display: 'swap',\n    12→})\n    13→\n    14→export default function App({ Component, pageProps }: AppProps) {\n    15→  const router = useRouter()\n    16→\n    17→  useEffect(() => {\n    18→    // Track initial page view\n    19→    trackPageView(router.asPath)\n    20→\n    21→    // Track subsequent page views on route change\n    22→    const handleRouteChange = (url: string) => {\n    23→      trackPageView(url)\n    24→    }\n    25→\n    26→    router.events.on('routeChangeComplete', handleRouteChange)\n    27→\n    28→    return () => {\n    29→      router.events.off('routeChangeComplete', handleRouteChange)\n    30→    }\n    31→  }, [router])\n    32→\n    33→  return (\n    34→    <div className={spaceGrotesk.variable}>\n    35→      <Component {...pageProps} />\n    36→    </div>\n    37→  )\n    38→}\n    39→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bec0f40b-0ded-4745-babc-d02bc5d84c78","uuid":"9d06b2f3-c415-4707-9861-ffe0cc3df2fd","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/DupreeOpsLLC/pages/_app.tsx","content":"import '@/styles/globals.css'\nimport type { AppProps } from 'next/app'\nimport { useEffect } from 'react'\nimport { useRouter } from 'next/router'\nimport { trackPageView } from '@/lib/analytics'\nimport { Space_Grotesk } from 'next/font/google'\n\nconst spaceGrotesk = Space_Grotesk({\n  subsets: ['latin'],\n  variable: '--font-space-grotesk',\n  display: 'swap',\n})\n\nexport default function App({ Component, pageProps }: AppProps) {\n  const router = useRouter()\n\n  useEffect(() => {\n    // Track initial page view\n    trackPageView(router.asPath)\n\n    // Track subsequent page views on route change\n    const handleRouteChange = (url: string) => {\n      trackPageView(url)\n    }\n\n    router.events.on('routeChangeComplete', handleRouteChange)\n\n    return () => {\n      router.events.off('routeChangeComplete', handleRouteChange)\n    }\n  }, [router])\n\n  return (\n    <div className={spaceGrotesk.variable}>\n      <Component {...pageProps} />\n    </div>\n  )\n}\n","numLines":39,"startLine":1,"totalLines":39}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QV82dyNSymcJvu8vzBcuP7","type":"tool_result","content":"     1→import Head from 'next/head'\n     2→import { useEffect, useState } from 'react'\n     3→import { useTheme } from '@/hooks/useTheme'\n     4→import { trackThemeToggle, trackLinkClick, trackEmailClick, trackProductClick } from '@/lib/analytics'\n     5→\n     6→const products = [\n     7→  {\n     8→    name: 'TechMeStuff.com',\n     9→    description: 'Engineering calculators and tools for students, hobbyists, and professionals.',\n    10→    url: 'https://techmestuff.com',\n    11→  },\n    12→  {\n    13→    name: 'MatrixLoop.app',\n    14→    description: 'Analytics and coaching layer for social platforms and growth workflows.',\n    15→    url: 'https://matrixloop.app',\n    16→  },\n    17→  {\n    18→    name: 'GlowMog',\n    19→    description: 'Face fitness & habit app focused on realistic, research-backed glow-ups.',\n    20→    url: 'https://glowmog.com',\n    21→  },\n    22→  {\n    23→    name: 'YTQuizzes',\n    24→    description: 'Turn YouTube videos into quizzes so users actually remember what they watch.',\n    25→    url: 'https://ytquizzes.com',\n    26→  },\n    27→]\n    28→\n    29→export default function Home() {\n    30→  const { theme, toggleTheme, mounted } = useTheme()\n    31→  const [timeString, setTimeString] = useState<string>('')\n    32→\n    33→  // Simple live clock in user's local time (ET for you)\n    34→  useEffect(() => {\n    35→    const updateTime = () => {\n    36→      const now = new Date()\n    37→      const opts: Intl.DateTimeFormatOptions = {\n    38→        hour: '2-digit',\n    39→        minute: '2-digit',\n    40→        second: '2-digit',\n    41→        hour12: true,\n    42→        timeZone: 'America/New_York',\n    43→      }\n    44→      setTimeString(new Intl.DateTimeFormat('en-US', opts).format(now))\n    45→    }\n    46→    updateTime()\n    47→    const id = setInterval(updateTime, 1000)\n    48→    return () => clearInterval(id)\n    49→  }, [])\n    50→\n    51→  const handleThemeToggle = () => {\n    52→    const newTheme = theme === 'dark' ? 'light' : 'dark'\n    53→    toggleTheme()\n    54→    trackThemeToggle(newTheme)\n    55→  }\n    56→\n    57→  // Don't render until mounted to avoid hydration mismatch\n    58→  if (!mounted) {\n    59→    return null\n    60→  }\n    61→\n    62→  return (\n    63→    <>\n    64→      <Head>\n    65→        <title>Dupree Ops, LLC • Official Business Site</title>\n    66→        <meta\n    67→          name=\"description\"\n    68→          content=\"Official business website for Dupree Ops, LLC – operator of software, AI, and automation products.\"\n    69→        />\n    70→        <meta\n    71→          name=\"viewport\"\n    72→          content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes\"\n    73→        />\n    74→        <meta name=\"theme-color\" content=\"#0f172a\" media=\"(prefers-color-scheme: dark)\" />\n    75→        <meta name=\"theme-color\" content=\"#f8fafc\" media=\"(prefers-color-scheme: light)\" />\n    76→        <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n    77→        <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n    78→      </Head>\n    79→\n    80→      <div className=\"min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors\">\n    81→        <div className=\"max-w-5xl mx-auto px-4 sm:px-6 py-4 sm:py-6 md:py-10 space-y-6 sm:space-y-8 md:space-y-10\">\n    82→          {/* TOP BAR: title + theme toggle + time */}\n    83→          <header className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4\">\n    84→            <div className=\"flex-1 min-w-0\">\n    85→              <pre className=\"text-[9px] xs:text-[10px] sm:text-xs md:text-sm leading-snug text-emerald-700 dark:text-emerald-400 whitespace-pre font-mono overflow-x-auto\">\n    86→{String.raw`╔══════════════════════════════════════════════════════════════╗\n    87→║                         DUPREE OPS, LLC                      ║\n    88→║        AI & AUTOMATION STUDIO FOR MODERN BUSINESSES          ║\n    89→╚══════════════════════════════════════════════════════════════╝`}\n    90→              </pre>\n    91→              <p className=\"mt-2 text-xs sm:text-sm md:text-base text-slate-600 dark:text-slate-300\">\n    92→                &gt; Official business website for{' '}\n    93→                <span className=\"font-semibold\">Dupree Ops, LLC</span>. Used to verify ownership\n    94→                and operations of our products with providers such as Stripe, Twilio, and app\n    95→                stores.\n    96→              </p>\n    97→            </div>\n    98→\n    99→            <div className=\"flex flex-row sm:flex-col items-center sm:items-end gap-2 sm:gap-2 w-full sm:w-auto\">\n   100→              <button\n   101→                type=\"button\"\n   102→                onClick={handleThemeToggle}\n   103→                className=\"inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 shadow-sm active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[44px]\"\n   104→              >\n   105→                <span className=\"text-base\">{theme === 'dark' ? '🌙' : '☀️'}</span>\n   106→                <span className=\"hidden xs:inline\">{theme === 'dark' ? 'Dark mode' : 'Light mode'}</span>\n   107→              </button>\n   108→              <div className=\"text-xs sm:text-sm md:text-base text-slate-500 dark:text-slate-400 text-right sm:text-right\">\n   109→                <div className=\"hidden sm:block\">Local time (ET)</div>\n   110→                <div className=\"sm:hidden text-[10px]\">ET</div>\n   111→                <div className=\"font-mono text-xs sm:text-sm\">{timeString || '--:--:--'}</div>\n   112→              </div>\n   113→            </div>\n   114→          </header>\n   115→\n   116→          {/* HERO: founder / company snapshot (Yadwinder-style) */}\n   117→          <section aria-label=\"Company Snapshot\">\n   118→            <div className=\"grid gap-4 sm:gap-5 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1.2fr)]\">\n   119→              {/* Left: founder-style card */}\n   120→              <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 sm:p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/70\">\n   121→                <h1 className=\"text-lg sm:text-xl md:text-2xl font-display font-semibold\">Isaiah Dupree</h1>\n   122→                <p className=\"mt-1 text-sm sm:text-base text-slate-600 dark:text-slate-300\">\n   123→                  Founder, Dupree Ops, LLC • AI & Automation Systems\n   124→                </p>\n   125→\n   126→                <p className=\"mt-3 text-sm sm:text-base text-slate-700 dark:text-slate-200 leading-relaxed\">\n   127→                  I build and operate software products that turn complex workflows into simple,\n   128→                  repeatable systems. Dupree Ops, LLC is the studio behind several AI- and\n   129→                  automation-powered tools for creators, engineers, and small businesses.\n   130→                </p>\n   131→                <p className=\"mt-2 text-sm sm:text-base text-slate-700 dark:text-slate-200 leading-relaxed\">\n   132→                  From engineering calculators to social growth infrastructure and custom\n   133→                  automations, our focus is on clarity, reliability, and measurable impact.\n   134→                </p>\n   135→\n   136→                <div className=\"mt-4 sm:mt-5 flex flex-wrap items-center gap-2.5 sm:gap-3\">\n   137→                  <a\n   138→                    href=\"mailto:hello@dupreeops.com\"\n   139→                    onClick={() => trackEmailClick('hello@dupreeops.com')}\n   140→                    className=\"inline-flex items-center justify-center rounded-full border border-slate-900 bg-slate-900 px-4 sm:px-5 py-2.5 sm:py-3 text-sm font-medium text-slate-50 shadow-sm active:bg-black hover:bg-black dark:border-slate-100 dark:bg-slate-100 dark:text-slate-900 dark:active:bg-white dark:hover:bg-white transition-colors touch-manipulation min-h-[44px]\"\n   141→                  >\n   142→                    Send an email\n   143→                  </a>\n   144→                    <span className=\"inline-flex items-center rounded-full border border-emerald-500/70 bg-emerald-50 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-medium text-emerald-700 dark:border-emerald-400/70 dark:bg-emerald-900/40 dark:text-emerald-200\">\n   145→                    Available for select partnerships\n   146→                  </span>\n   147→                </div>\n   148→              </div>\n   149→\n   150→              {/* Right: quick \"experience / focus / links\" */}\n   151→              <div className=\"space-y-3 sm:space-y-3 text-xs sm:text-sm md:text-base\">\n   152→                <div className=\"rounded-lg border border-slate-200 bg-white/90 p-3 sm:p-4 dark:border-slate-800 dark:bg-slate-900/70\">\n   153→                  <p className=\"text-emerald-700 dark:text-emerald-400 font-semibold mb-2 text-xs sm:text-sm\">\n   154→                    EXPERIENCE & FOCUS\n   155→                  </p>\n   156→                  <ul className=\"space-y-1.5 text-slate-700 dark:text-slate-200 leading-relaxed\">\n   157→                    <li>▸ AI & workflow automation systems</li>\n   158→                    <li>▸ Web & mobile SaaS products</li>\n   159→                    <li>▸ Engineering tools & calculators</li>\n   160→                    <li>▸ Creator growth & analytics tooling</li>\n   161→                  </ul>\n   162→                </div>\n   163→\n   164→                <div className=\"rounded-lg border border-slate-200 bg-white/90 p-3 sm:p-4 dark:border-slate-800 dark:bg-slate-900/70\">\n   165→                  <p className=\"text-emerald-700 dark:text-emerald-400 font-semibold mb-2 text-xs sm:text-sm\">\n   166→                    LET&apos;S GET IN TOUCH\n   167→                  </p>\n   168→                  <div className=\"flex flex-wrap gap-2 sm:gap-2.5\">\n   169→                    <a\n   170→                      href=\"https://x.com/isaiahdupree33\"\n   171→                      target=\"_blank\"\n   172→                      rel=\"noreferrer\"\n   173→                      onClick={() => trackLinkClick('https://x.com/isaiahdupree33', 'Twitter / X')}\n   174→                      className=\"inline-flex items-center rounded-full border border-slate-300 px-3 sm:px-3.5 py-2 sm:py-2 text-xs sm:text-sm text-slate-700 active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[40px]\"\n   175→                    >\n   176→                      Twitter / X\n   177→                    </a>\n   178→                    <a\n   179→                      href=\"https://www.linkedin.com/in/isaiah-dupree33/\"\n   180→                      target=\"_blank\"\n   181→                      rel=\"noreferrer\"\n   182→                      onClick={() => trackLinkClick('https://www.linkedin.com/in/isaiah-dupree33/', 'LinkedIn')}\n   183→                      className=\"inline-flex items-center rounded-full border border-slate-300 px-3 sm:px-3.5 py-2 sm:py-2 text-xs sm:text-sm text-slate-700 active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[40px]\"\n   184→                    >\n   185→                      LinkedIn\n   186→                    </a>\n   187→                    <a\n   188→                      href=\"https://github.com/IsaiahDupree\"\n   189→                      target=\"_blank\"\n   190→                      rel=\"noreferrer\"\n   191→                      onClick={() => trackLinkClick('https://github.com/IsaiahDupree', 'GitHub')}\n   192→                      className=\"inline-flex items-center rounded-full border border-slate-300 px-3 sm:px-3.5 py-2 sm:py-2 text-xs sm:text-sm text-slate-700 active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[40px]\"\n   193→                    >\n   194→                      GitHub\n   195→                    </a>\n   196→                    <a\n   197→                      href=\"mailto:support@dupreeops.com\"\n   198→                      onClick={() => trackEmailClick('support@dupreeops.com')}\n   199→                      className=\"inline-flex items-center rounded-full border border-slate-300 px-3 sm:px-3.5 py-2 sm:py-2 text-xs sm:text-sm text-slate-700 active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[40px]\"\n   200→                    >\n   201→                      Support\n   202→                    </a>\n   203→                  </div>\n   204→                </div>\n   205→              </div>\n   206→            </div>\n   207→          </section>\n   208→\n   209→          {/* ABOUT COMPANY */}\n   210→          <section id=\"about\" aria-label=\"About Company\" className=\"space-y-3\">\n   211→            <AsciiHeading label=\"ABOUT THE COMPANY\" />\n   212→            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 md:p-5 dark:border-slate-800 dark:bg-slate-900/70\">\n   213→              <p className=\"text-sm md:text-base text-slate-800 dark:text-slate-100 mb-3\">\n   214→                <strong>Dupree Ops, LLC</strong> is a software and automation studio focused on\n   215→                building durable infrastructure for creators, educators, and small businesses. We\n   216→                design and operate web & mobile applications, APIs, and internal tooling that make\n   217→                complex workflows simple.\n   218→              </p>\n   219→              <p className=\"text-sm md:text-base text-slate-700 dark:text-slate-200 mb-3\">\n   220→                Our products range from engineering calculators and educational tools to analytics\n   221→                layers and AI-powered workflow systems. Each major product runs on its own domain,\n   222→                but all are owned and operated under this company.\n   223→              </p>\n   224→\n   225→              <div className=\"grid gap-4 md:grid-cols-2 text-sm md:text-base\">\n   226→                <div>\n   227→                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n   228→                    ► Business details\n   229→                  </p>\n   230→                  <p className=\"text-slate-700 dark:text-slate-200\">\n   231→                    Registered name: Dupree Ops, LLC\n   232→                  </p>\n   233→                  <p className=\"text-slate-700 dark:text-slate-200\">Jurisdiction: Florida, United States</p>\n   234→                  <p className=\"text-slate-700 dark:text-slate-200\">\n   235→                    Mailing address: 3425 Delaney Drive, Melbourne, FL 32934\n   236→                  </p>\n   237→                  <p className=\"text-slate-700 dark:text-slate-200\">\n   238→                    Primary focus: Software, AI, and workflow automation\n   239→                  </p>\n   240→                </div>\n   241→                <div>\n   242→                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n   243→                    ► What we do\n   244→                  </p>\n   245→                  <ul className=\"list-none space-y-1 text-slate-700 dark:text-slate-200\">\n   246→                    <li>▸ Design & operate SaaS products and APIs</li>\n   247→                    <li>▸ Ship AI-assisted tools and automations</li>\n   248→                    <li>▸ Develop engineering & learning utilities</li>\n   249→                  </ul>\n   250→                </div>\n   251→              </div>\n   252→            </div>\n   253→          </section>\n   254→\n   255→          {/* PRODUCTS */}\n   256→          <section id=\"products\" aria-label=\"Products & Websites\" className=\"space-y-3\">\n   257→            <AsciiHeading label=\"PRODUCTS & WEBSITES\" />\n   258→            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 md:p-5 space-y-4 dark:border-slate-800 dark:bg-slate-900/70\">\n   259→              <p className=\"text-sm md:text-base text-slate-700 dark:text-slate-200\">\n   260→                Below is a partial list of products and domains currently operated by Dupree Ops,\n   261→                LLC. These may appear in billing descriptors, API integrations, or messaging\n   262→                traffic.\n   263→              </p>\n   264→\n   265→              <div className=\"grid gap-3 sm:gap-4 md:grid-cols-2\">\n   266→                {products.map((product) => (\n   267→                  <div\n   268→                    key={product.name}\n   269→                    className=\"flex flex-col justify-between rounded-md border border-slate-200 bg-slate-50/80 p-3 sm:p-4 dark:border-slate-700 dark:bg-slate-950/70\"\n   270→                  >\n   271→                    <div>\n   272→                      <div className=\"flex items-center justify-between gap-2 mb-1.5 sm:mb-2\">\n   273→                        <span className=\"font-semibold text-sm sm:text-base text-slate-900 dark:text-slate-50\">\n   274→                          {product.name}\n   275→                        </span>\n   276→                      </div>\n   277→                      <p className=\"text-xs sm:text-sm md:text-base text-slate-700 dark:text-slate-200 leading-relaxed\">\n   278→                        {product.description}\n   279→                      </p>\n   280→                    </div>\n   281→                    <div className=\"mt-3 sm:mt-4\">\n   282→                      <a\n   283→                        href={product.url}\n   284→                        target=\"_blank\"\n   285→                        rel=\"noreferrer\"\n   286→                        onClick={() => trackProductClick(product.name, product.url)}\n   287→                        className=\"inline-flex items-center text-sm sm:text-base text-emerald-700 active:text-emerald-600 hover:text-emerald-500 dark:text-emerald-400 dark:active:text-emerald-300 dark:hover:text-emerald-300 transition-colors touch-manipulation py-1\"\n   288→                      >\n   289→                        [ visit site → ]\n   290→                      </a>\n   291→                    </div>\n   292→                  </div>\n   293→                ))}\n   294→              </div>\n   295→\n   296→              <p className=\"text-sm md:text-base text-slate-500 dark:text-slate-400\">\n   297→                Additional experimental projects and internal tools may be deployed under\n   298→                subdomains and are still owned and operated by Dupree Ops, LLC unless otherwise\n   299→                specified.\n   300→              </p>\n   301→            </div>\n   302→          </section>\n   303→\n   304→          {/* LEGAL */}\n   305→          <section id=\"legal\" aria-label=\"Legal & Compliance\" className=\"space-y-3\">\n   306→            <AsciiHeading label=\"LEGAL & COMPLIANCE\" />\n   307→            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 md:p-5 space-y-4 dark:border-slate-800 dark:bg-slate-900/70\">\n   308→              <p className=\"text-sm md:text-base text-slate-700 dark:text-slate-200\">\n   309→                We maintain clear policies for how we process payments, protect data, and send\n   310→                communications. These policies apply across our products unless a specific product\n   311→                provides additional terms.\n   312→              </p>\n   313→\n   314→              <div className=\"grid gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-4 text-xs sm:text-sm md:text-base\">\n   315→                <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-700 dark:bg-slate-950/70\">\n   316→                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n   317→                    ► Terms of Service\n   318→                  </p>\n   319→                  <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n   320→                    Usage guidelines, acceptable use, and limitations of liability for our websites,\n   321→                    apps, and APIs.\n   322→                  </p>\n   323→                  <a\n   324→                    href=\"/terms\"\n   325→                    onClick={() => trackLinkClick('/terms', 'Terms of Service')}\n   326→                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n   327→                  >\n   328→                    [ view /terms ]\n   329→                  </a>\n   330→                </div>\n   331→\n   332→                <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-700 dark:bg-slate-950/70\">\n   333→                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n   334→                    ► Privacy Policy\n   335→                  </p>\n   336→                  <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n   337→                    What data we collect, how we use it, and the third-party providers we rely on\n   338→                    (e.g. Stripe, Twilio, analytics).\n   339→                  </p>\n   340→                  <a\n   341→                    href=\"/privacy\"\n   342→                    onClick={() => trackLinkClick('/privacy', 'Privacy Policy')}\n   343→                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n   344→                  >\n   345→                    [ view /privacy ]\n   346→                  </a>\n   347→                </div>\n   348→\n   349→                <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-700 dark:bg-slate-950/70\">\n   350→                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n   351→                    ► Billing & Messaging\n   352→                  </p>\n   353→                  <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n   354→                    Subscription billing, refunds, and how transactional + optional marketing\n   355→                    messages are sent and can be opted out of.\n   356→                  </p>\n   357→                  <a\n   358→                    href=\"/billing\"\n   359→                    onClick={() => trackLinkClick('/billing', 'Billing & Messaging')}\n   360→                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n   361→                  >\n   362→                    [ view /billing ]\n   363→                  </a>\n   364→                </div>\n   365→\n   366→                <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-700 dark:bg-slate-950/70\">\n   367→                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n   368→                    ► SMS Policy\n   369→                  </p>\n   370→                  <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n   371→                    SMS opt-in/opt-out, message frequency, sample messages, and carrier\n   372→                    information for our Twilio-powered messaging programs.\n   373→                  </p>\n   374→                  <a\n   375→                    href=\"/sms\"\n   376→                    onClick={() => trackLinkClick('/sms', 'SMS Policy')}\n   377→                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n   378→                  >\n   379→                    [ view /sms ]\n   380→                  </a>\n   381→                </div>\n   382→              </div>\n   383→\n   384→              <div className=\"rounded-md border border-emerald-200 bg-emerald-50/60 p-3 sm:p-4 text-sm md:text-base dark:border-emerald-900/50 dark:bg-emerald-950/30\">\n   385→                <p className=\"text-emerald-700 dark:text-emerald-400 mb-2 font-semibold\">\n   386→                  ► SMS / Text Messaging Program\n   387→                </p>\n   388→                <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n   389→                  Dupree Ops, LLC sends SMS messages through Twilio for transactional notifications\n   390→                  related to our products (e.g. appointment confirmations, account alerts, service\n   391→                  updates). Users provide explicit opt-in consent at the point of account creation\n   392→                  or service enrollment.\n   393→                </p>\n   394→                <ul className=\"list-none space-y-1 text-slate-700 dark:text-slate-200 ml-3 mb-2\">\n   395→                  <li>▸ <strong>Opt-in:</strong> Users check a consent box at sign-up or reply START to an enrollment message.</li>\n   396→                  <li>▸ <strong>Opt-out:</strong> Reply STOP to any message to unsubscribe immediately.</li>\n   397→                  <li>▸ <strong>Help:</strong> Reply HELP for support. Contact support@dupreeops.com.</li>\n   398→                  <li>▸ <strong>Message frequency:</strong> Varies by service; typically 1–5 messages per month.</li>\n   399→                  <li>▸ <strong>Rates:</strong> Message and data rates may apply.</li>\n   400→                </ul>\n   401→                <p className=\"text-slate-700 dark:text-slate-200\">\n   402→                  Sample messages: <em>\"Your appointment is confirmed for [date] at [time]. Reply STOP to unsubscribe.\"</em>{' '}\n   403→                  |{' '}<em>\"Action required: verify your account by clicking [link]. Reply STOP to opt out.\"</em>\n   404→                </p>\n   405→                <p className=\"mt-2 text-slate-600 dark:text-slate-300 text-xs sm:text-sm\">\n   406→                  Full SMS policy:{' '}\n   407→                  <a\n   408→                    href=\"/sms\"\n   409→                    onClick={() => trackLinkClick('/sms', 'SMS Policy')}\n   410→                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n   411→                  >\n   412→                    dupreeops.com/sms\n   413→                  </a>\n   414→                </p>\n   415→              </div>\n   416→\n   417→              <p className=\"text-sm md:text-base text-slate-500 dark:text-slate-400\">\n   418→                Messaging traffic sent via Twilio follows our opt-in and opt-out policies, including\n   419→                support for STOP/UNSUBSCRIBE commands. See{' '}\n   420→                <a\n   421→                  href=\"/billing\"\n   422→                  onClick={() => trackLinkClick('/billing', 'Billing & Messaging')}\n   423→                  className=\"text-emerald-600 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n   424→                >\n   425→                  /billing\n   426→                </a>{' '}\n   427→                for full details.\n   428→              </p>\n   429→            </div>\n   430→          </section>\n   431→\n   432→          {/* CONTACT */}\n   433→          <section id=\"contact\" aria-label=\"Contact & Verification\" className=\"space-y-3\">\n   434→            <AsciiHeading label=\"CONTACT & VERIFICATION\" />\n   435→            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 md:p-5 space-y-4 dark:border-slate-800 dark:bg-slate-900/70\">\n   436→              <div className=\"text-sm md:text-base\">\n   437→                <div>\n   438→                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n   439→                    ► Primary contact\n   440→                  </p>\n   441→                  <p className=\"text-slate-700 dark:text-slate-200\">\n   442→                    Business email:{' '}\n   443→                    <a\n   444→                      href=\"mailto:hello@dupreeops.com\"\n   445→                      onClick={() => trackEmailClick('hello@dupreeops.com')}\n   446→                      className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n   447→                    >\n   448→                      hello@dupreeops.com\n   449→                    </a>\n   450→                  </p>\n   451→                  <p className=\"text-slate-700 dark:text-slate-200\">\n   452→                    Support email:{' '}\n   453→                    <a\n   454→                      href=\"mailto:support@dupreeops.com\"\n   455→                      onClick={() => trackEmailClick('support@dupreeops.com')}\n   456→                      className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n   457→                    >\n   458→                      support@dupreeops.com\n   459→                    </a>\n   460→                  </p>\n   461→                  <p className=\"mt-2 text-slate-700 dark:text-slate-200\">\n   462→                    Typical response time: 1–2 business days.\n   463→                  </p>\n   464→                </div>\n   465→              </div>\n   466→\n   467→              <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 text-sm md:text-base dark:border-slate-700 dark:bg-slate-950/70\">\n   468→                <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n   469→                  ► For providers & reviewers\n   470→                </p>\n   471→                <p className=\"text-slate-700 dark:text-slate-200\">\n   472→                  If you are verifying an account, integration, or application associated with\n   473→                  Dupree Ops, LLC and require additional documentation, please reach out via the\n   474→                  business email above with your reference ID and context. We are happy to confirm\n   475→                  ownership of domains, products, and messaging campaigns.\n   476→                </p>\n   477→              </div>\n   478→            </div>\n   479→          </section>\n   480→\n   481→          {/* FOOTER */}\n   482→          <footer aria-label=\"Footer\">\n   483→            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 text-center text-sm md:text-base text-slate-500 dark:border-slate-800 dark:bg-slate-900/70 dark:text-slate-400\">\n   484→              <pre className=\"mb-2 text-xs md:text-sm leading-snug text-emerald-700 dark:text-emerald-400 whitespace-pre font-mono\">\n   485→{String.raw`╔══════════════════════════════════════════════╗\n   486→║        crafted_with_care_by_dupree_ops       ║\n   487→╚══════════════════════════════════════════════╝`}\n   488→              </pre>\n   489→              <p>\n   490→                © {new Date().getFullYear()} Dupree Ops, LLC • Built with Next.js & Tailwind CSS\n   491→              </p>\n   492→            </div>\n   493→          </footer>\n   494→        </div>\n   495→      </div>\n   496→    </>\n   497→  )\n   498→}\n   499→\n   500→/**\n   501→ * ASCII-style section heading (auto-sizes the line to the label length).\n   502→ */\n   503→function AsciiHeading({ label }: { label: string }) {\n   504→  const line = '═'.repeat(Math.max(label.length + 4, 28))\n   505→  return (\n   506→    <pre className=\"text-xs md:text-sm leading-snug text-emerald-700 dark:text-emerald-400 whitespace-pre font-mono\">\n   507→{`╔${line}╗\n   508→║ ${label.padEnd(line.length - 2, ' ')}║\n   509→╚${line}╝`}\n   510→    </pre>\n   511→  )\n   512→}\n   513→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bec0f40b-0ded-4745-babc-d02bc5d84c78","uuid":"bdfc0549-56a3-4c36-9528-d57aa70ce889","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/DupreeOpsLLC/pages/index.tsx","content":"import Head from 'next/head'\nimport { useEffect, useState } from 'react'\nimport { useTheme } from '@/hooks/useTheme'\nimport { trackThemeToggle, trackLinkClick, trackEmailClick, trackProductClick } from '@/lib/analytics'\n\nconst products = [\n  {\n    name: 'TechMeStuff.com',\n    description: 'Engineering calculators and tools for students, hobbyists, and professionals.',\n    url: 'https://techmestuff.com',\n  },\n  {\n    name: 'MatrixLoop.app',\n    description: 'Analytics and coaching layer for social platforms and growth workflows.',\n    url: 'https://matrixloop.app',\n  },\n  {\n    name: 'GlowMog',\n    description: 'Face fitness & habit app focused on realistic, research-backed glow-ups.',\n    url: 'https://glowmog.com',\n  },\n  {\n    name: 'YTQuizzes',\n    description: 'Turn YouTube videos into quizzes so users actually remember what they watch.',\n    url: 'https://ytquizzes.com',\n  },\n]\n\nexport default function Home() {\n  const { theme, toggleTheme, mounted } = useTheme()\n  const [timeString, setTimeString] = useState<string>('')\n\n  // Simple live clock in user's local time (ET for you)\n  useEffect(() => {\n    const updateTime = () => {\n      const now = new Date()\n      const opts: Intl.DateTimeFormatOptions = {\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit',\n        hour12: true,\n        timeZone: 'America/New_York',\n      }\n      setTimeString(new Intl.DateTimeFormat('en-US', opts).format(now))\n    }\n    updateTime()\n    const id = setInterval(updateTime, 1000)\n    return () => clearInterval(id)\n  }, [])\n\n  const handleThemeToggle = () => {\n    const newTheme = theme === 'dark' ? 'light' : 'dark'\n    toggleTheme()\n    trackThemeToggle(newTheme)\n  }\n\n  // Don't render until mounted to avoid hydration mismatch\n  if (!mounted) {\n    return null\n  }\n\n  return (\n    <>\n      <Head>\n        <title>Dupree Ops, LLC • Official Business Site</title>\n        <meta\n          name=\"description\"\n          content=\"Official business website for Dupree Ops, LLC – operator of software, AI, and automation products.\"\n        />\n        <meta\n          name=\"viewport\"\n          content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes\"\n        />\n        <meta name=\"theme-color\" content=\"#0f172a\" media=\"(prefers-color-scheme: dark)\" />\n        <meta name=\"theme-color\" content=\"#f8fafc\" media=\"(prefers-color-scheme: light)\" />\n        <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n        <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n      </Head>\n\n      <div className=\"min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors\">\n        <div className=\"max-w-5xl mx-auto px-4 sm:px-6 py-4 sm:py-6 md:py-10 space-y-6 sm:space-y-8 md:space-y-10\">\n          {/* TOP BAR: title + theme toggle + time */}\n          <header className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4\">\n            <div className=\"flex-1 min-w-0\">\n              <pre className=\"text-[9px] xs:text-[10px] sm:text-xs md:text-sm leading-snug text-emerald-700 dark:text-emerald-400 whitespace-pre font-mono overflow-x-auto\">\n{String.raw`╔══════════════════════════════════════════════════════════════╗\n║                         DUPREE OPS, LLC                      ║\n║        AI & AUTOMATION STUDIO FOR MODERN BUSINESSES          ║\n╚══════════════════════════════════════════════════════════════╝`}\n              </pre>\n              <p className=\"mt-2 text-xs sm:text-sm md:text-base text-slate-600 dark:text-slate-300\">\n                &gt; Official business website for{' '}\n                <span className=\"font-semibold\">Dupree Ops, LLC</span>. Used to verify ownership\n                and operations of our products with providers such as Stripe, Twilio, and app\n                stores.\n              </p>\n            </div>\n\n            <div className=\"flex flex-row sm:flex-col items-center sm:items-end gap-2 sm:gap-2 w-full sm:w-auto\">\n              <button\n                type=\"button\"\n                onClick={handleThemeToggle}\n                className=\"inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 shadow-sm active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[44px]\"\n              >\n                <span className=\"text-base\">{theme === 'dark' ? '🌙' : '☀️'}</span>\n                <span className=\"hidden xs:inline\">{theme === 'dark' ? 'Dark mode' : 'Light mode'}</span>\n              </button>\n              <div className=\"text-xs sm:text-sm md:text-base text-slate-500 dark:text-slate-400 text-right sm:text-right\">\n                <div className=\"hidden sm:block\">Local time (ET)</div>\n                <div className=\"sm:hidden text-[10px]\">ET</div>\n                <div className=\"font-mono text-xs sm:text-sm\">{timeString || '--:--:--'}</div>\n              </div>\n            </div>\n          </header>\n\n          {/* HERO: founder / company snapshot (Yadwinder-style) */}\n          <section aria-label=\"Company Snapshot\">\n            <div className=\"grid gap-4 sm:gap-5 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1.2fr)]\">\n              {/* Left: founder-style card */}\n              <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 sm:p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/70\">\n                <h1 className=\"text-lg sm:text-xl md:text-2xl font-display font-semibold\">Isaiah Dupree</h1>\n                <p className=\"mt-1 text-sm sm:text-base text-slate-600 dark:text-slate-300\">\n                  Founder, Dupree Ops, LLC • AI & Automation Systems\n                </p>\n\n                <p className=\"mt-3 text-sm sm:text-base text-slate-700 dark:text-slate-200 leading-relaxed\">\n                  I build and operate software products that turn complex workflows into simple,\n                  repeatable systems. Dupree Ops, LLC is the studio behind several AI- and\n                  automation-powered tools for creators, engineers, and small businesses.\n                </p>\n                <p className=\"mt-2 text-sm sm:text-base text-slate-700 dark:text-slate-200 leading-relaxed\">\n                  From engineering calculators to social growth infrastructure and custom\n                  automations, our focus is on clarity, reliability, and measurable impact.\n                </p>\n\n                <div className=\"mt-4 sm:mt-5 flex flex-wrap items-center gap-2.5 sm:gap-3\">\n                  <a\n                    href=\"mailto:hello@dupreeops.com\"\n                    onClick={() => trackEmailClick('hello@dupreeops.com')}\n                    className=\"inline-flex items-center justify-center rounded-full border border-slate-900 bg-slate-900 px-4 sm:px-5 py-2.5 sm:py-3 text-sm font-medium text-slate-50 shadow-sm active:bg-black hover:bg-black dark:border-slate-100 dark:bg-slate-100 dark:text-slate-900 dark:active:bg-white dark:hover:bg-white transition-colors touch-manipulation min-h-[44px]\"\n                  >\n                    Send an email\n                  </a>\n                    <span className=\"inline-flex items-center rounded-full border border-emerald-500/70 bg-emerald-50 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-medium text-emerald-700 dark:border-emerald-400/70 dark:bg-emerald-900/40 dark:text-emerald-200\">\n                    Available for select partnerships\n                  </span>\n                </div>\n              </div>\n\n              {/* Right: quick \"experience / focus / links\" */}\n              <div className=\"space-y-3 sm:space-y-3 text-xs sm:text-sm md:text-base\">\n                <div className=\"rounded-lg border border-slate-200 bg-white/90 p-3 sm:p-4 dark:border-slate-800 dark:bg-slate-900/70\">\n                  <p className=\"text-emerald-700 dark:text-emerald-400 font-semibold mb-2 text-xs sm:text-sm\">\n                    EXPERIENCE & FOCUS\n                  </p>\n                  <ul className=\"space-y-1.5 text-slate-700 dark:text-slate-200 leading-relaxed\">\n                    <li>▸ AI & workflow automation systems</li>\n                    <li>▸ Web & mobile SaaS products</li>\n                    <li>▸ Engineering tools & calculators</li>\n                    <li>▸ Creator growth & analytics tooling</li>\n                  </ul>\n                </div>\n\n                <div className=\"rounded-lg border border-slate-200 bg-white/90 p-3 sm:p-4 dark:border-slate-800 dark:bg-slate-900/70\">\n                  <p className=\"text-emerald-700 dark:text-emerald-400 font-semibold mb-2 text-xs sm:text-sm\">\n                    LET&apos;S GET IN TOUCH\n                  </p>\n                  <div className=\"flex flex-wrap gap-2 sm:gap-2.5\">\n                    <a\n                      href=\"https://x.com/isaiahdupree33\"\n                      target=\"_blank\"\n                      rel=\"noreferrer\"\n                      onClick={() => trackLinkClick('https://x.com/isaiahdupree33', 'Twitter / X')}\n                      className=\"inline-flex items-center rounded-full border border-slate-300 px-3 sm:px-3.5 py-2 sm:py-2 text-xs sm:text-sm text-slate-700 active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[40px]\"\n                    >\n                      Twitter / X\n                    </a>\n                    <a\n                      href=\"https://www.linkedin.com/in/isaiah-dupree33/\"\n                      target=\"_blank\"\n                      rel=\"noreferrer\"\n                      onClick={() => trackLinkClick('https://www.linkedin.com/in/isaiah-dupree33/', 'LinkedIn')}\n                      className=\"inline-flex items-center rounded-full border border-slate-300 px-3 sm:px-3.5 py-2 sm:py-2 text-xs sm:text-sm text-slate-700 active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[40px]\"\n                    >\n                      LinkedIn\n                    </a>\n                    <a\n                      href=\"https://github.com/IsaiahDupree\"\n                      target=\"_blank\"\n                      rel=\"noreferrer\"\n                      onClick={() => trackLinkClick('https://github.com/IsaiahDupree', 'GitHub')}\n                      className=\"inline-flex items-center rounded-full border border-slate-300 px-3 sm:px-3.5 py-2 sm:py-2 text-xs sm:text-sm text-slate-700 active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[40px]\"\n                    >\n                      GitHub\n                    </a>\n                    <a\n                      href=\"mailto:support@dupreeops.com\"\n                      onClick={() => trackEmailClick('support@dupreeops.com')}\n                      className=\"inline-flex items-center rounded-full border border-slate-300 px-3 sm:px-3.5 py-2 sm:py-2 text-xs sm:text-sm text-slate-700 active:bg-slate-100 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:active:bg-slate-800 dark:hover:bg-slate-800 transition-colors touch-manipulation min-h-[40px]\"\n                    >\n                      Support\n                    </a>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n\n          {/* ABOUT COMPANY */}\n          <section id=\"about\" aria-label=\"About Company\" className=\"space-y-3\">\n            <AsciiHeading label=\"ABOUT THE COMPANY\" />\n            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 md:p-5 dark:border-slate-800 dark:bg-slate-900/70\">\n              <p className=\"text-sm md:text-base text-slate-800 dark:text-slate-100 mb-3\">\n                <strong>Dupree Ops, LLC</strong> is a software and automation studio focused on\n                building durable infrastructure for creators, educators, and small businesses. We\n                design and operate web & mobile applications, APIs, and internal tooling that make\n                complex workflows simple.\n              </p>\n              <p className=\"text-sm md:text-base text-slate-700 dark:text-slate-200 mb-3\">\n                Our products range from engineering calculators and educational tools to analytics\n                layers and AI-powered workflow systems. Each major product runs on its own domain,\n                but all are owned and operated under this company.\n              </p>\n\n              <div className=\"grid gap-4 md:grid-cols-2 text-sm md:text-base\">\n                <div>\n                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n                    ► Business details\n                  </p>\n                  <p className=\"text-slate-700 dark:text-slate-200\">\n                    Registered name: Dupree Ops, LLC\n                  </p>\n                  <p className=\"text-slate-700 dark:text-slate-200\">Jurisdiction: Florida, United States</p>\n                  <p className=\"text-slate-700 dark:text-slate-200\">\n                    Mailing address: 3425 Delaney Drive, Melbourne, FL 32934\n                  </p>\n                  <p className=\"text-slate-700 dark:text-slate-200\">\n                    Primary focus: Software, AI, and workflow automation\n                  </p>\n                </div>\n                <div>\n                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n                    ► What we do\n                  </p>\n                  <ul className=\"list-none space-y-1 text-slate-700 dark:text-slate-200\">\n                    <li>▸ Design & operate SaaS products and APIs</li>\n                    <li>▸ Ship AI-assisted tools and automations</li>\n                    <li>▸ Develop engineering & learning utilities</li>\n                  </ul>\n                </div>\n              </div>\n            </div>\n          </section>\n\n          {/* PRODUCTS */}\n          <section id=\"products\" aria-label=\"Products & Websites\" className=\"space-y-3\">\n            <AsciiHeading label=\"PRODUCTS & WEBSITES\" />\n            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 md:p-5 space-y-4 dark:border-slate-800 dark:bg-slate-900/70\">\n              <p className=\"text-sm md:text-base text-slate-700 dark:text-slate-200\">\n                Below is a partial list of products and domains currently operated by Dupree Ops,\n                LLC. These may appear in billing descriptors, API integrations, or messaging\n                traffic.\n              </p>\n\n              <div className=\"grid gap-3 sm:gap-4 md:grid-cols-2\">\n                {products.map((product) => (\n                  <div\n                    key={product.name}\n                    className=\"flex flex-col justify-between rounded-md border border-slate-200 bg-slate-50/80 p-3 sm:p-4 dark:border-slate-700 dark:bg-slate-950/70\"\n                  >\n                    <div>\n                      <div className=\"flex items-center justify-between gap-2 mb-1.5 sm:mb-2\">\n                        <span className=\"font-semibold text-sm sm:text-base text-slate-900 dark:text-slate-50\">\n                          {product.name}\n                        </span>\n                      </div>\n                      <p className=\"text-xs sm:text-sm md:text-base text-slate-700 dark:text-slate-200 leading-relaxed\">\n                        {product.description}\n                      </p>\n                    </div>\n                    <div className=\"mt-3 sm:mt-4\">\n                      <a\n                        href={product.url}\n                        target=\"_blank\"\n                        rel=\"noreferrer\"\n                        onClick={() => trackProductClick(product.name, product.url)}\n                        className=\"inline-flex items-center text-sm sm:text-base text-emerald-700 active:text-emerald-600 hover:text-emerald-500 dark:text-emerald-400 dark:active:text-emerald-300 dark:hover:text-emerald-300 transition-colors touch-manipulation py-1\"\n                      >\n                        [ visit site → ]\n                      </a>\n                    </div>\n                  </div>\n                ))}\n              </div>\n\n              <p className=\"text-sm md:text-base text-slate-500 dark:text-slate-400\">\n                Additional experimental projects and internal tools may be deployed under\n                subdomains and are still owned and operated by Dupree Ops, LLC unless otherwise\n                specified.\n              </p>\n            </div>\n          </section>\n\n          {/* LEGAL */}\n          <section id=\"legal\" aria-label=\"Legal & Compliance\" className=\"space-y-3\">\n            <AsciiHeading label=\"LEGAL & COMPLIANCE\" />\n            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 md:p-5 space-y-4 dark:border-slate-800 dark:bg-slate-900/70\">\n              <p className=\"text-sm md:text-base text-slate-700 dark:text-slate-200\">\n                We maintain clear policies for how we process payments, protect data, and send\n                communications. These policies apply across our products unless a specific product\n                provides additional terms.\n              </p>\n\n              <div className=\"grid gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-4 text-xs sm:text-sm md:text-base\">\n                <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-700 dark:bg-slate-950/70\">\n                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n                    ► Terms of Service\n                  </p>\n                  <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n                    Usage guidelines, acceptable use, and limitations of liability for our websites,\n                    apps, and APIs.\n                  </p>\n                  <a\n                    href=\"/terms\"\n                    onClick={() => trackLinkClick('/terms', 'Terms of Service')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    [ view /terms ]\n                  </a>\n                </div>\n\n                <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-700 dark:bg-slate-950/70\">\n                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n                    ► Privacy Policy\n                  </p>\n                  <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n                    What data we collect, how we use it, and the third-party providers we rely on\n                    (e.g. Stripe, Twilio, analytics).\n                  </p>\n                  <a\n                    href=\"/privacy\"\n                    onClick={() => trackLinkClick('/privacy', 'Privacy Policy')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    [ view /privacy ]\n                  </a>\n                </div>\n\n                <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-700 dark:bg-slate-950/70\">\n                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n                    ► Billing & Messaging\n                  </p>\n                  <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n                    Subscription billing, refunds, and how transactional + optional marketing\n                    messages are sent and can be opted out of.\n                  </p>\n                  <a\n                    href=\"/billing\"\n                    onClick={() => trackLinkClick('/billing', 'Billing & Messaging')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    [ view /billing ]\n                  </a>\n                </div>\n\n                <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-700 dark:bg-slate-950/70\">\n                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n                    ► SMS Policy\n                  </p>\n                  <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n                    SMS opt-in/opt-out, message frequency, sample messages, and carrier\n                    information for our Twilio-powered messaging programs.\n                  </p>\n                  <a\n                    href=\"/sms\"\n                    onClick={() => trackLinkClick('/sms', 'SMS Policy')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    [ view /sms ]\n                  </a>\n                </div>\n              </div>\n\n              <div className=\"rounded-md border border-emerald-200 bg-emerald-50/60 p-3 sm:p-4 text-sm md:text-base dark:border-emerald-900/50 dark:bg-emerald-950/30\">\n                <p className=\"text-emerald-700 dark:text-emerald-400 mb-2 font-semibold\">\n                  ► SMS / Text Messaging Program\n                </p>\n                <p className=\"text-slate-700 dark:text-slate-200 mb-2\">\n                  Dupree Ops, LLC sends SMS messages through Twilio for transactional notifications\n                  related to our products (e.g. appointment confirmations, account alerts, service\n                  updates). Users provide explicit opt-in consent at the point of account creation\n                  or service enrollment.\n                </p>\n                <ul className=\"list-none space-y-1 text-slate-700 dark:text-slate-200 ml-3 mb-2\">\n                  <li>▸ <strong>Opt-in:</strong> Users check a consent box at sign-up or reply START to an enrollment message.</li>\n                  <li>▸ <strong>Opt-out:</strong> Reply STOP to any message to unsubscribe immediately.</li>\n                  <li>▸ <strong>Help:</strong> Reply HELP for support. Contact support@dupreeops.com.</li>\n                  <li>▸ <strong>Message frequency:</strong> Varies by service; typically 1–5 messages per month.</li>\n                  <li>▸ <strong>Rates:</strong> Message and data rates may apply.</li>\n                </ul>\n                <p className=\"text-slate-700 dark:text-slate-200\">\n                  Sample messages: <em>\"Your appointment is confirmed for [date] at [time]. Reply STOP to unsubscribe.\"</em>{' '}\n                  |{' '}<em>\"Action required: verify your account by clicking [link]. Reply STOP to opt out.\"</em>\n                </p>\n                <p className=\"mt-2 text-slate-600 dark:text-slate-300 text-xs sm:text-sm\">\n                  Full SMS policy:{' '}\n                  <a\n                    href=\"/sms\"\n                    onClick={() => trackLinkClick('/sms', 'SMS Policy')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    dupreeops.com/sms\n                  </a>\n                </p>\n              </div>\n\n              <p className=\"text-sm md:text-base text-slate-500 dark:text-slate-400\">\n                Messaging traffic sent via Twilio follows our opt-in and opt-out policies, including\n                support for STOP/UNSUBSCRIBE commands. See{' '}\n                <a\n                  href=\"/billing\"\n                  onClick={() => trackLinkClick('/billing', 'Billing & Messaging')}\n                  className=\"text-emerald-600 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                >\n                  /billing\n                </a>{' '}\n                for full details.\n              </p>\n            </div>\n          </section>\n\n          {/* CONTACT */}\n          <section id=\"contact\" aria-label=\"Contact & Verification\" className=\"space-y-3\">\n            <AsciiHeading label=\"CONTACT & VERIFICATION\" />\n            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 md:p-5 space-y-4 dark:border-slate-800 dark:bg-slate-900/70\">\n              <div className=\"text-sm md:text-base\">\n                <div>\n                  <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n                    ► Primary contact\n                  </p>\n                  <p className=\"text-slate-700 dark:text-slate-200\">\n                    Business email:{' '}\n                    <a\n                      href=\"mailto:hello@dupreeops.com\"\n                      onClick={() => trackEmailClick('hello@dupreeops.com')}\n                      className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                    >\n                      hello@dupreeops.com\n                    </a>\n                  </p>\n                  <p className=\"text-slate-700 dark:text-slate-200\">\n                    Support email:{' '}\n                    <a\n                      href=\"mailto:support@dupreeops.com\"\n                      onClick={() => trackEmailClick('support@dupreeops.com')}\n                      className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                    >\n                      support@dupreeops.com\n                    </a>\n                  </p>\n                  <p className=\"mt-2 text-slate-700 dark:text-slate-200\">\n                    Typical response time: 1–2 business days.\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"rounded-md border border-slate-200 bg-slate-50/80 p-3 text-sm md:text-base dark:border-slate-700 dark:bg-slate-950/70\">\n                <p className=\"text-emerald-700 dark:text-emerald-400 mb-1 font-semibold\">\n                  ► For providers & reviewers\n                </p>\n                <p className=\"text-slate-700 dark:text-slate-200\">\n                  If you are verifying an account, integration, or application associated with\n                  Dupree Ops, LLC and require additional documentation, please reach out via the\n                  business email above with your reference ID and context. We are happy to confirm\n                  ownership of domains, products, and messaging campaigns.\n                </p>\n              </div>\n            </div>\n          </section>\n\n          {/* FOOTER */}\n          <footer aria-label=\"Footer\">\n            <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 text-center text-sm md:text-base text-slate-500 dark:border-slate-800 dark:bg-slate-900/70 dark:text-slate-400\">\n              <pre className=\"mb-2 text-xs md:text-sm leading-snug text-emerald-700 dark:text-emerald-400 whitespace-pre font-mono\">\n{String.raw`╔══════════════════════════════════════════════╗\n║        crafted_with_care_by_dupree_ops       ║\n╚══════════════════════════════════════════════╝`}\n              </pre>\n              <p>\n                © {new Date().getFullYear()} Dupree Ops, LLC • Built with Next.js & Tailwind CSS\n              </p>\n            </div>\n          </footer>\n        </div>\n      </div>\n    </>\n  )\n}\n\n/**\n * ASCII-style section heading (auto-sizes the line to the label length).\n */\nfunction AsciiHeading({ label }: { label: string }) {\n  const line = '═'.repeat(Math.max(label.length + 4, 28))\n  return (\n    <pre className=\"text-xs md:text-sm leading-snug text-emerald-700 dark:text-emerald-400 whitespace-pre font-mono\">\n{`╔${line}╗\n║ ${label.padEnd(line.length - 2, ' ')}║\n╚${line}╝`}\n    </pre>\n  )\n}\n","numLines":513,"startLine":1,"totalLines":513}}}
