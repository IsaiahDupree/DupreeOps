rrer\"\n                    onClick={() => trackLinkClick('https://github.com/IsaiahDupree', 'GitHub')}\n                    className=\"text-emerald-700 hover:text-emerald-500 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors\"\n                  >\n                    GitHub →\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n    </>\n  )\n}\n\nfunction AsciiHeading({ label }: { label: string }) {\n  const line = '═'.repeat(Math.max(label.length + 4, 28))\n  return (\n    <pre className=\"text-xs md:text-sm leading-snug text-emerald-700 dark:text-emerald-400 whitespace-pre font-mono\">\n{`╔${line}╗\n║ ${label.padEnd(line.length - 2, ' ')}║\n╚${line}╝`}\n    </pre>\n  )\n}\n","structuredPatch":[{"oldStart":2,"oldLines":6,"newStart":2,"newLines":7,"lines":[" import Link from 'next/link'"," import { useTheme } from '@/hooks/useTheme'"," import { trackThemeToggle, trackLinkClick, trackEmailClick } from '@/lib/analytics'","+import ContactForm from '@/components/ContactForm'"," "," export default function Contact() {","   const { theme, toggleTheme, mounted } = useTheme()"]},{"oldStart":50,"oldLines":10,"newStart":51,"newLines":21,"lines":["             </button>","           </div>"," ","+          {/* Contact form section */}","           <div className=\"rounded-lg border border-slate-200 bg-white/90 p-4 sm:p-5 md:p-6 dark:border-slate-800 dark:bg-slate-900/70\">","-            <AsciiHeading label=\"CONTACT\" />","+            <AsciiHeading label=\"GET IN TOUCH\" />","+            <p className=\"mt-4 text-sm sm:text-base text-slate-700 dark:text-slate-200 mb-4 sm:mb-6\">","+              Have a project in mind or want to learn more about our services? Fill out the form below and","+              we'll get back to you within 1-2 business days.","+            </p>","+            <ContactForm />","+          </div>"," ","-            <div className=\"mt-4 sm:mt-6 