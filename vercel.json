{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/learn",
      "destination": "https://authority-os-iota.vercel.app/api/editorial/public/dupreeops"
    },
    {
      "source": "/learn/:path*",
      "destination": "https://authority-os-iota.vercel.app/api/editorial/public/dupreeops/:path*"
    }
  ]
}
